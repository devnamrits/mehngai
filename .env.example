# Bright Data (required)
# Account Settings -> API key. CLI uses this headless instead of bdata login.
BRIGHTDATA_API_KEY=

# Collector IDs (pinned after creation via `bdata scraper create`)
COLLECTOR_CHAIN_A=
COLLECTOR_CHAIN_B=
COLLECTOR_CHAIN_C=

# Storage
DATABASE_URL=file:./mehngai.db

# Telegram alerts (optional for MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
