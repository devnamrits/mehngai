# Mehngai backend env contract
# Copy to .env for local dev; set the same keys in Render/Vercel dashboards.

ENVIRONMENT=development

# Neon Postgres connection string (production) or local sqlite for dev
DATABASE_URL=sqlite:///./mehngai.db

# Bright Data (headless auth — no `bdata login` needed)
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_BASE=https://api.brightdata.com

# Comma-separated Collector IDs pinned after `bdata scraper create`
COLLECTOR_IDS=c_aaa,c_bbb,c_ccc

# Shared secret required by POST /api/v1/pipeline/run
PIPELINE_TOKEN=change-me

# Frontend origin allowed by CORS (Vercel URL)
CORS_ORIGINS=http://localhost:3000

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
